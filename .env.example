# Copy to .env.local for a real Clerk + Neon trial. Leave these blank and run
# `node tools/dev-server.mjs` to try collections on this computer only.
# Never put secret values in the repository.

# Clerk. Both are required before Sign in appears on the deployed site.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres connection string. Required to keep collections after a deploy.
DATABASE_URL=

# Local only. The dev server sets MEMBERS_DEV for you.
# Ignored whenever VERCEL_ENV=production.
# MEMBERS_DEV=1
# MEMBERS_DEV_SECRET=
# MEMBERS_STORE_PATH=
